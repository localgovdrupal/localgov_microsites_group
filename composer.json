{
    "name": "drupal/localgov_microsites_group",
    "description": "Group integration required for LocalGov Microsites.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "drupal/domain_path": "^1.5",
        "drupal/field_formatter_class": "^1.5",
        "drupal/ginvite": "^4.0",
        "drupal/group": "^3.3",
        "drupal/group_content_menu": "^3.0",
        "drupal/group_context_domain": "^1.0",
        "drupal/group_sites": "^1.0",
        "drupal/group_term": "^4.0",
        "drupal/groupmedia": "^4.0.1",
        "drupal/override_node_options": "^2.6",
        "drupal/replicate": "^1.0",
        "drupal/role_delegation": "^1.2",
        "drupal/variationcache": "^1.5",
        "localgovdrupal/group_webform": "^1.0.0-beta2",
        "drupal/localgov_core": "^2.12",
        "drupal/localgov_forms": "^1.0.0-beta2",
        "drupal/localgov_search": "^1.2"
    },
    "require-dev": {
        "drupal/admin_toolbar": "^3.6",
        "drupal/localgov_base": "^2.2",
        "drupal/localgov_blogs": "^1.0",
        "drupal/localgov_directories": "^3.0",
        "drupal/localgov_events": "^3.0",
        "drupal/localgov_guides": "^2.0",
        "drupal/localgov_news": "^2.1",
        "drupal/localgov_paragraphs": "^2.5"
    },
    "extra": {
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/domain_path": {
                "domain_path_pathauto creates duplicate aliases #3285213": "https://www.drupal.org/files/issues/2022-06-11/domain_path_pathauto-obey-current-domain_id-querying-for-reserved-aliases-3285213.patch"
            },
            "drupal/group": {
                "Node previews don't work when adding group node https://www.drupal.org/project/group/issues/2853001#comment-16252793": "https://git.drupalcode.org/project/group/-/commit/3b7f6203884b934750f1a6d2e09caba98dac7be5.patch"
            }
        }
    }
}
